<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background_dark" android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="32dp" android:paddingBottom="32dp">

        <!-- Header Section -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="32dp" android:paddingBottom="24dp" android:gravity="center">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="34sp" android:textColor="#FFFFFF" android:textStyle="bold" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ready_text" android:textColor="#B3B3B3" android:textSize="18sp" />

        </LinearLayout>

        <!-- Server Status Card -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" android:layout_marginHorizontal="24dp" android:layout_marginVertical="16dp" android:background="@color/card_background_dark" android:alpha="0.95" android:elevation="4dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="24dp" android:gravity="center_vertical">

                <!-- Server Icon -->
                <ImageView android:id="@+id/serverIcon" android:layout_width="64dp" android:layout_height="64dp" android:layout_marginEnd="16dp" android:src="@android:drawable/ic_media_play" android:tint="@color/status_running" />

                <!-- Status Text -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                    <TextView android:id="@+id/serviceStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/server_stopped" android:textSize="20sp" android:textColor="#FFFFFF" android:textStyle="bold" />

                    <TextView android:id="@+id/serviceReadyText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/port_info" android:textSize="16sp" android:textColor="#B3B3B3" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Connected Devices Section -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="24dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <!-- Devices Header -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="20dp" android:gravity="center_vertical">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/connected_devices_title" android:textSize="18sp" android:textColor="#FFFFFF" android:textStyle="bold" android:gravity="start" android:layout_margin="0dp" />

                    <Button android:id="@+id/refreshButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_rotate" />

                </LinearLayout>

                <!-- Devices List -->
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/devicesRecyclerView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:paddingHorizontal="12dp" android:minHeight="120dp" />

                <!-- No Devices Message -->
                <TextView android:id="@+id/noDevicesText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="32dp" android:gravity="center" android:text="@string/no_devices_connected" android:textSize="16sp" android:textColor="#FFFFFF" android:textStyle="italic" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Service Control Button -->
        <Button android:id="@+id/serviceButton" style="@style/ModernButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/start_service" android:textSize="18sp" />

    </LinearLayout>

</ScrollView>
